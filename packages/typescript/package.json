{
  "name": "@nonagentic/research-contracts",
  "version": "0.9.0",
  "description": "TypeScript parity for the DataCompany canonical contract and hash engine (FND-001/002/005)",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "lint": "eslint \"src/**/*.ts\" \"test/**/*.ts\" \"tools/**/*.ts\"",
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "fuzz:build": "tsc -p tsconfig.tools.json",
    "ci:verify": "npm run lint && npm run typecheck && npm test"
  },
  "overrides": {
    "brace-expansion": "^5.0.8"
  },
  "license": "Apache-2.0",
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "@types/node": "^25.9.3",
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1",
    "eslint": "^10.5.0",
    "jest": "^30.4.2",
    "ts-jest": "^29.4.11",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.61.1"
  }
}
