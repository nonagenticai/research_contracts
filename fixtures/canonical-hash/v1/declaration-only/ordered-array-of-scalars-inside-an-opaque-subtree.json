    "properties": {
      "id": {
        "type": "string"
      },
      "value": {
        "type": "object",
        "x-datacompany-hash-opaque": true,
        "properties": {
          "tags": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "x-datacompany-hash-declaration-only": true,
            "x-datacompany-array": {
              "kind": "ordered"
            }
          }
        }
      }
    },
    "x-datacompany-composition-point": "#/$defs/domain_extension",
    "$defs": {
      "domain_extension": {
        "$comment": "Declared composition point. The runtime route below supplies an arrays-only profile extension, and merge_profile_extensions accepts one only at an envelope's declared composition point (EXTENSIONS.md section 6.4).",
        "type": "object"
      }
    }
  },
  "expected_manifest_canonical_json": "{\"absent_vs_null\":\"distinct\",\"arrays\":[{\"kind\":\"ordered\",\"pointer\":\"/value/tags\"}],\"binary_float_policy\":\"reject\",\"byte_order_mark\":false,\"decimal_representation\":\"decimal_string\",\"digest_algorithm\":\"sha256\",\"digest_prefix\":\"sha256:\",\"encoding\":\"utf-8\",\"excluded_pointers\":[],\"included_pointers\":[\"/id\",\"/value\"],\"opaque_pointers\":[\"/value\"],\"profile_id\":\"urn:datacompany:canonical-hash-profile:1\",\"profile_version\":2,\"schema_ref\":\"urn:datacompany:declaration-only-scalar-array-probe:1\",\"serialization\":\"rfc8785\",\"timestamp_representation\":\"rfc3339_utc_z\",\"unicode_normalization\":\"none\"}",
